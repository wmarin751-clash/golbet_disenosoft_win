@using GolBet.Entities.Enums
@using GolBet.Services.Helpers
@model GolBet.Services.DTOs.MatchDetailDto
@{
    ViewData["Title"] = $"{Model.HomeTeamName} vs {Model.AwayTeamName}";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Partidos</a></li>
        <li class="breadcrumb-item active">@Model.HomeTeamName vs @Model.AwayTeamName</li>
    </ol>
</nav>

<div class="card shadow-sm">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>📅 @Model.Date.ToString("dddd dd MMM yyyy · h:mm tt")</span>
        @switch (Model.Status)
        {
            case MatchStatus.Scheduled:
                <span class="badge bg-primary">Programado</span>
                break;
            case MatchStatus.InProgress:
                <span class="badge bg-warning">En juego</span>
                break;
            case MatchStatus.Finished:
                <span class="badge bg-secondary">Finalizado</span>
                break;
        }
    </div>

    <div class="card-body">
        <div class="d-flex align-items-center justify-content-around text-center">
            <div>
                <img src="@(Model.HomeTeamCrestUrl ?? "https://placehold.co/80x80/e9ecef/6c757d?text=FC")"
                     width="80" height="80" />
                <h5 class="mt-2">@Model.HomeTeamName</h5>
            </div>

            @if (Model.Status == MatchStatus.Finished)
            {
                <h2 class="fw-bold">@Model.HomeGoals - @Model.AwayGoals</h2>
            }
            else
            {
                <h3 class="text-muted">vs</h3>
            }

            <div>
                <img src="@(Model.AwayTeamCrestUrl ?? "https://placehold.co/80x80/e9ecef/6c757d?text=FC")"
                     width="80" height="80" />
                <h5 class="mt-2">@Model.AwayTeamName</h5>
            </div>
        </div>

        <hr />

        <div class="d-flex justify-content-around mt-3">
            <div class="text-center">
                <div class="text-muted small">Local (1)</div>
                <div class="fs-4 fw-bold">@Model.HomeOdds</div>
            </div>
            <div class="text-center">
                <div class="text-muted small">Empate (X)</div>
                <div class="fs-4 fw-bold">@Model.DrawOdds</div>
            </div>
            <div class="text-center">
                <div class="text-muted small">Visitante (2)</div>
                <div class="fs-4 fw-bold">@Model.AwayOdds</div>
            </div>
        </div>
    </div>

    <div class="card-footer d-flex justify-content-between align-items-center">
        <small class="text-muted">🎟️ @Model.TotalBets apuestas realizadas</small>
        <div>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary">Editar</a>
            @if (Model.Status == MatchStatus.Scheduled)
            {
                <button class="btn btn-success" disabled
                        title="Disponible cuando implementemos las apuestas">
                    Apostar (Módulo 8)
                </button>
            }
        </div>
    </div>
</div>
